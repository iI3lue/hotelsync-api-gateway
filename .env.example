FRONT_DESK_SERVICE_URL=https://hotelsync-front-desk-service.onrender.com/v1
HOUSEKEEPING_SERVICE_URL=https://hotelsync-housekeeping-service.onrender.com/v1
BILLING_SERVICE_URL=https://hotelsync-billing-service.onrender.com/v1
LOYALTY_SERVICE_URL=https://hotelsync-loyalty-service.onrender.com/v1
PAYMENTS_SERVICE_URL=https://hotelsync-payment-service.onrender.com/v1
ANALYTICS_SERVICE_URL=https://hotelsync-analytics-service.onrender.com/v1
