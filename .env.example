NODE_ENV=production
PORT=8080
UPSTREAM_TIMEOUT_MS=10000
GATEWAY_SHARED_SECRET=replace-with-a-random-32-plus-character-secret

# Despertar servicios free dormidos: primer request autenticado = ping a todos.
WAKE_ALL_ENABLED=true
WAKE_ALL_INTERVAL_MS=1800000
WAKE_ALL_TIMEOUT_MS=60000

PROPERTY_SERVICE_URL=https://hotelsync-property-service.onrender.com/v1
